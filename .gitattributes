# POSIX 入口必须保留 LF，不能随 Windows checkout 转为 CRLF。
*.sh text eol=lf
# 显式下载当前平台测试核心的 CI 脚本在所有 runner 上保持相同源码字节。
qoder-subscription-proxy/scripts/prepare-test-core.mjs text eol=lf
# POSIX 分发脚本按行读取相对路径。
qoder-subscription-proxy/scripts/distribution-files.txt text eol=lf
# 随包上游原文在 Windows checkout 后也应保留已核对的字节。
qoder-subscription-proxy/server/bin/LICENSE text eol=lf
qoder-subscription-proxy/server/magpie-third-party-notices.txt text eol=lf
